# Copy to .env before running docker compose up --build.
# Use a URL-safe password because docker-compose interpolates it into a DB URL.
POSTGRES_PASSWORD=replace-with-a-long-random-url-safe-password

# Optional API authentication. The dashboard prompts for this key and keeps it
# only in the browser session; do not embed it in the dashboard build.
TOOLCALL_API_KEY=

# Server-side model credentials. Never enter these into dashboard forms.
TOOLCALL_BENCH_MODEL=
TOOLCALL_BENCH_BASE_URL=
TOOLCALL_BENCH_API_KEY=
TOOLCALL_CORS_ORIGINS=
